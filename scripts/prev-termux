#!/usr/bin/env bash
# ============================================================
# prev-termux — CLI for building old Termux package versions
# via GitHub Actions releases.
#
# Dependencies: git, gh (GitHub CLI), jq (fzf es opcional; sin él se usa un menú numerado)
# ============================================================
set -euo pipefail

# ─── Configuration ───────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

# GitHub repository where releases and the build workflow live.
# Auto-detected from `gh repo view`; override via GITHUB_REPOSITORY env var.
RELEASE_REPO="${GITHUB_REPOSITORY:-}"
if [[ -z "$RELEASE_REPO" ]] && command -v gh &>/dev/null; then
    RELEASE_REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
fi

readonly WORKFLOW_FILE="build-old-package.yml"

# Auto-detect default branch; overridable via PREV_TERMUX_WORKFLOW_REF env var.
WORKFLOW_REF="${PREV_TERMUX_WORKFLOW_REF:-}"
if [[ -z "$WORKFLOW_REF" ]] && command -v gh &>/dev/null; then
    WORKFLOW_REF="$(gh repo view --json defaultBranch --jq '.defaultBranch' -R "$RELEASE_REPO" 2>/dev/null || echo "main")"
fi
if [[ -z "$WORKFLOW_REF" ]]; then
    WORKFLOW_REF="main"
fi
readonly WORKFLOW_REF

# ─── Install paths (configurable via env) ────────────────────────────────────────

PREV_TERMUX_INSTALL_DIR="${PREV_TERMUX_INSTALL_DIR:-${HOME}/.local/opt}"
PREV_TERMUX_BIN_DIR="${PREV_TERMUX_BIN_DIR:-${HOME}/.local/bin}"

# ─── Source discover library (required) ─────────────────────────────────────────

if [[ ! -f "$LIB_DIR/discover.sh" ]]; then
    echo "[ERROR] Required library not found: $LIB_DIR/discover.sh" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$LIB_DIR/discover.sh"

# Source optional build library (if present)
if [[ -f "$LIB_DIR/build.sh" ]]; then
    # shellcheck source=/dev/null
    source "$LIB_DIR/build.sh"
fi

# ─── Colors ──────────────────────────────────────────────────────────────────────

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly BOLD='\033[1m'
readonly NC='\033[0m'

# ─── Logging Helpers ─────────────────────────────────────────────────────────────

info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }
die()   { err "$*"; exit 1; }

# ─── Dependency Check ────────────────────────────────────────────────────────────

check_deps() {
    local missing=()
    # fzf es opcional: cada subcomando que lo use cae al menú numerado
    # (_select_line) si no está instalado. Solo se exigen los imprescindibles.
    for cmd in git gh jq; do
        command -v "$cmd" &>/dev/null || missing+=("$cmd")
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        die "Missing required dependencies: ${missing[*]}
Install them with:
  pkg install ${missing[*]}"
    fi

    info "Checking GitHub CLI authentication..."
    if ! gh auth status &>/dev/null; then
        gh auth status 2>&1 || true
        die "gh is not authenticated. Run 'gh auth login' first."
    fi
    ok "GitHub CLI authenticated"

    if [[ -z "$RELEASE_REPO" ]]; then
        die "Could not determine the GitHub repository.
  • Set GITHUB_REPOSITORY env var, e.g.:
      export GITHUB_REPOSITORY=your-org/PrevTermuxPackage
  • Or run 'gh repo set-default' inside a git clone of your repository"
    fi
    ok "Release repository: ${RELEASE_REPO}"
}

# ─── subinstall helpers ─────────────────────────────────────────────────────────

# ─── _parse_artifact_name ─────────────────────────────────────────────────────
# Parsea {pkg}|{version} del nombre de un artifact. Acepta los dos estilos de
# nombre y ambos formatos de paquete:
#   release/estándar:  bat-0.7.1-0-aarch64.pkg.tar.xz      → bat|0.7.1
#   pool (store):      bat_0.7.1_aarch64.pkg.tar.xz        → bat|0.7.1
#                      bat_0.7.1_aarch64_subversioned.pkg.tar.xz → bat|0.7.1
#                      libpng16_1.6.43_all_subversioned.pkg.tar.xz → libpng16|1.6.43
#   .deb:              bash_5.1.16_aarch64_subversioned.deb → bash|5.1.16
# El sufijo subversioned se elimina ANTES de parsear y el separador pkg/ver
# puede ser '-' (release) o '_' (pool). Devuelve "pkg|version" por stdout;
# vacío (y exit 1) si no se puede parsear.
_parse_artifact_name() {
    local filename="$1"
    local base pkg version arch

    base="${filename%.pkg.tar.*}"
    if [[ "$base" == "$filename" ]]; then
        base="${filename%.deb}"
    fi
    # Ni .pkg.tar.* ni .deb
    [[ "$base" == "$filename" ]] && return 1

    # Sufijo subversioned (pool: _subversioned; release: -subversioned)
    base="${base%_subversioned}"
    base="${base%-subversioned}"

    # Arquitectura final (con separador '-' o '_')
    for arch in aarch64 arm i686 x86_64 all; do
        base="${base%-${arch}}"
        base="${base%_${arch}}"
    done

    # Revisión final solo en estilo release: {pkg}-{ver}-{rev}
    if [[ "$base" =~ -[0-9]+$ ]]; then
        base="${base%-[0-9]*}"
    fi

    # base = {pkg}[-_]{ver}; ver es el último segmento que empieza con dígito.
    version="$(echo "$base" | sed -E 's/^.*[-_]([0-9][^-_]*)$/\1/')"
    pkg="$(echo "$base" | sed -E 's/^(.*)[-_][0-9][^-_]*$/\1/')"

    if [[ -z "$version" || -z "$pkg" || "$pkg" == "$base" ]]; then
        return 1
    fi
    printf '%s|%s\n' "$pkg" "$version"
}

# ─── _escape_regex ─────────────────────────────────────────────────────────────
# Escapa meta-caracteres de ERE para usar un nombre de paquete (p.ej. 'libc++')
# como texto literal dentro de una expresión sed -E.
_escape_regex() {
    printf '%s' "$1" | sed 's/[][\\^$.*+?(){}|]/\\&/g'
}

# ─── _artifact_version_for_pkg ────────────────────────────────────────────────
# Cross-check de paquete para descargas de release (subinstall/install).
# Determina si el artifact descargado pertenece al paquete pedido, parseando
# desde la IZQUIERDA (con $pkg como ancla) en vez de desde la derecha. El
# parseo desde la derecha (usado por _parse_artifact_name para el flujo local)
# rompe versiones con guiones: libedit-20210216-3.1-0-aarch64.pkg.tar.xz
# parsearía como pkg=libedit-20210216 (falso negativo). Aquí se valida:
#   1. Quitar sufijos conocidos por la derecha: .pkg.tar.xz/.deb,
#      -subversioned/_subversioned, -{arch}/_{arch} y -{revisión numérica}.
#   2. El resto debe empezar por "${pkg}" seguido de '-' o '_'; si no, el
#      artifact es de OTRO paquete (p.ej. python-numpy al pedir python).
#   3. La versión (resto tras el prefijo) debe empezar por dígito: un resto
#      como "numpy-1.26.4" no es una versión de 'python' sino otro paquete.
#      (Supuesto documentado: TERMUX_PKG_VERSION del rango 2018-2023 empieza
#      siempre por dígito; p.ej. 20210216-3.1, 1.3-20260107, 0.24-1.)
# Imprime la versión extraída por stdout (exit 0) si corresponde al paquete;
# nada (exit 1) si no corresponde. $pkg se usa como texto literal (no regex),
# así que nombres con '+' (libc++) funcionan sin escape.
_artifact_version_for_pkg() {
    local filename="$1"
    local pkg="$2"
    local base rest arch

    base="${filename%.pkg.tar.*}"
    if [[ "$base" == "$filename" ]]; then
        base="${filename%.deb}"
    fi
    # Ni .pkg.tar.* ni .deb
    [[ "$base" == "$filename" ]] && return 1

    # Sufijo subversioned (pool: _subversioned; release: -subversioned)
    base="${base%_subversioned}"
    base="${base%-subversioned}"

    # Arquitectura final (con separador '-' o '_')
    for arch in aarch64 arm i686 x86_64 all; do
        base="${base%-${arch}}"
        base="${base%_${arch}}"
    done

    # Revisión final solo en estilo release: {pkg}-{ver}-{rev}
    if [[ "$base" =~ -[0-9]+$ ]]; then
        base="${base%-[0-9]*}"
    fi

    # El resto debe empezar por ${pkg} seguido de '-' o '_'
    case "$base" in
        "${pkg}"-*|"${pkg}"_*) ;;
        *) return 1 ;;
    esac

    rest="${base#${pkg}-}"
    rest="${rest#${pkg}_}"

    # La versión debe parecer una versión: empieza por dígito. Un resto como
    # "numpy-1.26.4" (pkg pedido 'python') es una colisión de prefijo.
    case "$rest" in
        [0-9]*) printf '%s\n' "$rest" ;;
        *) return 1 ;;
    esac
}

# ─── _version_label ─────────────────────────────────────────────────────────────
# Label de presentación de una versión para _select_line (fzf o menú numerado):
#   {pkg}-{ver}  [normal, subversioned] | [normal] | [subversioned]
# Usado TANTO para construir las opciones del selector como para resolver la
# línea elegida de vuelta a su versión (match exacto, sin parsear regex).
_version_label() {
    local pkg="$1" ver="$2" normal="$3" sub="$4"
    local modes=""
    if [[ "$normal" == "y" && "$sub" == "y" ]]; then
        modes="[normal, subversioned]"
    elif [[ "$normal" == "y" ]]; then
        modes="[normal]"
    else
        modes="[subversioned]"
    fi
    printf '%s\n' "${pkg}-${ver}  ${modes}"
}

# ─── _release_tags ──────────────────────────────────────────────────────────────
# Parsea el JSON de `gh release list --json tagName,createdAt` y devuelve por
# stdout las tags del paquete con forma {pkg}-{ver}-{sha7}(-subversioned), una
# por línea en TSV:
#   ver \t createdAt \t tagName \t modo
# donde modo es "normal" o "subversioned". La versión se extrae con el mismo
# enfoque de ver_tag (sed con $pkg_re escapado, tolerando guiones en {ver}).
# Descarta colisiones de prefijo: una tag 'python-numpy-1.26.4-aaa1111' al pedir
# 'python' extraería ver 'numpy-1.26.4', que no empieza por dígito (regla
# documentada en _artifact_version_for_pkg) y se filtra aquí. El orden de salida
# es el de entrada de gh release list (más recientes primero).
_release_tags() {
    local releases_json="$1"
    local pkg="$2"
    local pkg_re
    pkg_re="$(_escape_regex "$pkg")"
    printf '%s' "$releases_json" | jq -r --arg p "$pkg" --arg pr "$pkg_re" '
        [ .[] | select(.tagName | startswith($p + "-")) |
                 select(.tagName | test("^" + $pr + "-.+-[0-9a-f]{7}(-subversioned)?$")) ]
        | .[] | . as $t
        | ($t.tagName | sub("^" + $pr + "-"; "") | sub("-[0-9a-f]{7}(-subversioned)?$"; "")) as $v
        | select($v | test("^[0-9]"))
        | [ $v, $t.createdAt, $t.tagName,
            (if ($t.tagName | test("-subversioned$")) then "subversioned" else "normal" end)
          ] | @tsv
    ' 2>/dev/null || true
}

# ─── _release_versions ──────────────────────────────────────────────────────────
# Agrega las filas TSV de _release_tags en VERSIONES ÚNICAS con sus modos.
# Recibe el TSV (ver \t date \t tag \t modo) por argumento y devuelve por
# stdout una fila por versión en TSV:
#   ver \t normal(y|n) \t sub(y|n) \t createdAt_máx \t tag_normal \t tag_sub
# donde tag_normal/tag_sub son las tags MÁS RECIENTES de ese modo para la
# versión (primeras en aparecer: la entrada de gh release list ya viene de más
# reciente a más antigua). Ordenadas por createdAt desc (más reciente primero),
# no lexicográfico.
_release_versions() {
    local tags_txt="$1"
    local ver="" date="" tag="" mode=""
    local -A vdate=() vn=() vs=()
    while IFS=$'\t' read -r ver date tag mode; do
        [[ -z "$ver" ]] && continue
        if [[ -z "${vdate[$ver]:-}" || "$date" > "${vdate[$ver]}" ]]; then
            vdate[$ver]="$date"
        fi
        if [[ "$mode" == "normal" ]]; then
            [[ -z "${vn[$ver]:-}" ]] && vn[$ver]="$tag"
        else
            [[ -z "${vs[$ver]:-}" ]] && vs[$ver]="$tag"
        fi
    done <<< "$tags_txt"

    local v="" n="" s=""
    for v in "${!vdate[@]}"; do
        n="n"; s="n"
        [[ -n "${vn[$v]:-}" ]] && n="y"
        [[ -n "${vs[$v]:-}" ]] && s="y"
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$v" "$n" "$s" "${vdate[$v]}" "${vn[$v]:-}" "${vs[$v]:-}"
    done | sort -t$'\t' -k4,4r
}

# ─── _subinstall_extract ───────────────────────────────────────────────────────
# Extrae un artifact a ~/.local/opt/<pkg>-<version>/. Acepta pkg/version
# EXPLÍCITOS (opcionales): el flujo GitHub de cmd_subinstall los pasa ya
# verificados por el cross-check (_artifact_version_for_pkg) para no re-parsear
# el nombre del artifact (que truncaría versiones con guiones como
# libedit-20210216-3.1 → pkg 'libedit-20210216'). Si no se pasan (flujo local),
# se parsean del nombre del archivo.
_subinstall_extract() {
    local artifact="$1"
    local pkg="${2:-}" version="${3:-}"
    local parsed base_name
    base_name="$(basename "$artifact")"

    if [[ -z "$pkg" || -z "$version" ]]; then
        if parsed="$(_parse_artifact_name "$base_name")"; then
            pkg="${parsed%%|*}"
            version="${parsed#*|}"
        else
            warn "No se pudo parsear nombre/versión de '${base_name}'; usando fallback."
            pkg="${base_name%.pkg.tar.*}"
            version="unknown"
        fi
    fi

    extract_artifact "$artifact" "$pkg" "$version"
}

# ─── extract_artifact ──────────────────────────────────────────────────────────
# Extrae un .pkg.tar.xz a ~/.local/opt/<pkg>-<version>/ con symlinks para cada
# binario en ~/.local/bin/<bin>-<version>.
#
# Detecta automáticamente el layout del tar (vía tar -tf + grep):
#   subversioned →  data/data/com.termux/files/home/.local/opt/<pkg>-<ver>/...
#   standard     →  data/data/com.termux/files/usr/...
#
extract_artifact() {
    local artifact="$1"
    local pkg="$2"
    local version="$3"
    local install_dir="${PREV_TERMUX_INSTALL_DIR:-${HOME}/.local/opt}"
    local bin_dir="${PREV_TERMUX_BIN_DIR:-${HOME}/.local/bin}"
    local pkg_versioned="${pkg}-${version}"
    local target="${install_dir}/${pkg_versioned}"

    # Ya instalado?
    if [[ -d "$target" ]]; then
        ok "Package '${pkg_versioned}' is already installed at:"
        echo "  ${target}"
        if [[ -L "${bin_dir}/${pkg_versioned}" ]]; then
            echo "  Symlink: ${bin_dir}/${pkg_versioned}"
        fi
        return 0
    fi

    # ── Detección de layout ───────────────────────────────────────────────────
    # Primer path que delate el prefijo:
    #   home/.local/opt/       → release subversioned (prefix ~/.local/opt)
    #   com.termux/files/usr/  → release estándar (layout actual)
    local layout="standard"
    local first_match
    first_match="$(tar -tf "$artifact" 2>/dev/null | grep -m1 -E 'home/.local/opt/|com.termux/files/usr/' || true)"
    if [[ "$first_match" == *"home/.local/opt/"* ]]; then
        layout="subversioned"
    fi

    info "Extracting '${pkg_versioned}' to ${target}... (layout: ${layout})"
    mkdir -p "$target"

    if [[ "$layout" == "subversioned" ]]; then
        # ── Layout versionado: extraer a $HOME ────────────────────────────────
        # Ruta interna del tar:
        #   data/data/com.termux/files/home/.local/opt/<pkg>-<ver>/...
        # Componentes del prefijo a eliminar:
        #   data(1) data(2) com.termux(3) files(4) home(5)
        # → --strip-components=5 deja .local/opt/<pkg>-<ver>/... relativo a $HOME
        # → $HOME/.local/opt/<pkg>-<ver>/... = target ✓
        # NOTA (aritmética verificada): el diseño original proponía strip 6,
        # pero 6 eliminaría también .local y dejaría opt/<pkg>-<ver>/ suelto
        # en $HOME (destino incorrecto). El strip correcto es 5.
        if ! tar -xf "$artifact" --strip-components=5 -C "$HOME" 2>/dev/null; then
            die "Failed to extract ${artifact} (subversioned layout)"
        fi
        # Defensa: confirmar que la extracción cayó en el destino esperado
        if [[ ! -d "$target" ]]; then
            die "Extraction did not produce expected directory: ${target}. Unexpected tar layout in ${artifact}"
        fi
    else
        # ── Layout estándar: comportamiento actual ────────────────────────────
        # Ruta interna: data/data/com.termux/files/usr/...
        # strip 5 → bin/... relativo a $target
        if tar -xf "$artifact" --strip-components=5 -C "$target" 2>/dev/null; then
            :  # OK
        elif tar -xf "$artifact" --strip-components=4 -C "$target" 2>/dev/null; then
            :  # OK
        else
            tar -xf "$artifact" -C "$target" 2>/dev/null || {
                die "Failed to extract ${artifact}"
            }
        fi
    fi

    # Mostrar contenido de bin/
    echo ""
    if [[ -d "${target}/bin" ]]; then
        echo "  Installed files in bin/:"
        ls -la "${target}/bin/" 2>/dev/null
        echo ""

        # Crear symlink versionado para cada binario
        mkdir -p "$bin_dir"
        local bin_file
        for bin_file in "${target}/bin/"*; do
            local bin_name
            bin_name=$(basename "$bin_file")
            local symlink_name="${bin_name}-${version}"
            ln -sf "$bin_file" "${bin_dir}/${symlink_name}"
            ok "Symlink: ${bin_dir}/${symlink_name} → ${bin_file}"
        done
    else
        warn "No bin/ directory found in extracted package."
        echo "  Extracted to: ${target}"
    fi
}

# ─── Command: list ───────────────────────────────────────────────────────────────
# Usage: prev-termux list <package>
#
# Discovers all historical versions of a Termux package, presents them
# in an interactive fzf selector, and prints the selected version details.
#
cmd_list() {
    local package=""
    local refresh=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --refresh) refresh=1; shift ;;
            --subversioned) shift ;;  # aceptado sin efecto (compatibilidad)
            -*)
                die "Unknown argument: $1"
                ;;
            *)
                if [[ -z "$package" ]]; then
                    package="$1"
                    shift
                else
                    die "Unknown argument: $1"
                fi
                ;;
        esac
    done

    [[ -z "$package" ]] && die "Usage: prev-termux list <package> [--refresh]"

    info "Discovering versions for '${package}'..."
    echo ""

    local selected=""
    if command -v fzf &>/dev/null; then
        selected="$(fzf_select "$package" "$refresh")" || die "Version selection cancelled or failed"
    else
        warn "fzf no está instalado; usando menú numerado..."
        local versions_txt=""
        versions_txt="$(get_cached_versions "$package" "$refresh")" || \
            die "No se pudieron obtener versiones de '${package}' (revisa la caché o instala fzf)."
        if [[ -z "$versions_txt" ]]; then
            die "No versions found for '${package}'"
        fi
        local -a versions=()
        mapfile -t versions <<< "$versions_txt"
        selected="$(_select_line "Selecciona versión de ${package}: " "${versions[@]}")" || die "Version selection cancelled or failed"
    fi
    [[ -z "$selected" ]] && die "No version selected"

    # Parse: version|commit_full|date|commit_short
    local version sha date short_sha
    IFS='|' read -r version sha date short_sha <<< "$selected"

    echo ""
    info "Selected version for ${package}:"
    echo -e "  ${BOLD}Version${NC}   ${version}"
    echo -e "  ${BOLD}Commit${NC}    ${sha}"
    echo -e "  ${BOLD}Date${NC}      ${date}"
}

# ─── Command: build ──────────────────────────────────────────────────────────────
# Usage: prev-termux build <package> [--commit <sha>] [--subversioned]
#
# Interactive mode (default): uses fzf to pick a version, then either downloads
#   the existing release or triggers a GHA workflow to build it.
# Direct mode (--commit): skips fzf, uses the provided commit SHA directly.
# --subversioned: targets the versioned release tag {pkg}-{ver}-{sha}-subversioned
#   (releases built with prefix ~/.local/opt/<pkg>-<ver>/).
#
cmd_build() {
    local package=""
    local commit_sha=""
    local refresh=0
    local zram=false
    local subversioned=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --commit)
                [[ -z "${2:-}" ]] && die "--commit requires a SHA argument"
                commit_sha="$2"
                shift 2
                ;;
            --commit=*)
                commit_sha="${1#*=}"
                shift
                ;;
            --refresh) refresh=1; shift ;;
            --heavy) zram=true; shift ;;
            --subversioned) subversioned=true; shift ;;
            -*)
                die "Unknown argument: $1"
                ;;
            *)
                if [[ -z "$package" ]]; then
                    package="$1"
                    shift
                else
                    die "Unknown argument: $1"
                fi
                ;;
        esac
    done

    [[ -z "$package" ]] && die "Usage: prev-termux build <package> [--commit <sha>] [--refresh] [--heavy] [--subversioned]"

    local version="" sha="" date="" short_sha=""

    # ── Resolve version & commit SHA ──────────────────────────────────────────

    if [[ -n "$commit_sha" ]]; then
        # ── Direct mode ───────────────────────────────────────────────────────
        info "Using commit: ${commit_sha}"
        sha="$commit_sha"
        short_sha="${sha:0:7}"

        # extract_version is provided by discover.sh
        version="$(extract_version "$sha" "$package")" || \
            die "Failed to extract version for commit ${sha} package ${package}"
        date="N/A"
        ok "Version: ${version} (from commit ${short_sha})"
    else
        # ── Interactive mode ──────────────────────────────────────────────────
        info "Discovering versions for '${package}'..."
        echo ""

        local selected
        if command -v fzf &>/dev/null; then
            selected="$(fzf_select "$package" "$refresh")" || die "Version selection cancelled or failed"
        else
            # fzf es opcional: sin él se replica el enfoque de cmd_list y se cae
            # al menú numerado (_select_line) con las versiones cacheadas, en el
            # mismo formato version|sha|date|short_sha que produce fzf_select.
            warn "fzf no está instalado; usando menú numerado..."
            local versions_txt=""
            versions_txt="$(get_cached_versions "$package" "$refresh")" || \
                die "No se pudieron obtener versiones de '${package}' (revisa la caché o instala fzf)."
            if [[ -z "$versions_txt" ]]; then
                die "No versions found for '${package}'"
            fi
            local -a versions=()
            mapfile -t versions <<< "$versions_txt"
            selected="$(_select_line "Selecciona versión de ${package}: " "${versions[@]}")" || die "Version selection cancelled or failed"
        fi
        [[ -z "$selected" ]] && die "No version selected"

        IFS='|' read -r version sha date short_sha <<< "$selected"
        ok "Selected: ${version} (${short_sha})"
    fi

    # ── Build tag ─────────────────────────────────────────────────────────────
    # Tag normal:     {package}-{version}-{short_sha}
    # Tag versionado: {package}-{version}-{short_sha}-subversioned
    # Sanitize: remove spaces, replace non-alphanumeric characters (except ._-)
    local tag_suffix=""
    if [[ "$subversioned" == "true" ]]; then
        tag_suffix="-subversioned"
    fi
    local tag_raw="${package}-${version}-${short_sha}${tag_suffix}"
    local tag
    tag="$(echo "$tag_raw" | tr -d ' ' | sed 's/[^a-zA-Z0-9._-]/-/g')"

    echo ""
    info "Build summary:"
    echo -e "  ${BOLD}Package${NC}   ${package}"
    echo -e "  ${BOLD}Version${NC}   ${version}"
    echo -e "  ${BOLD}Commit${NC}    ${sha}"
    echo -e "  ${BOLD}Date${NC}      ${date}"
    if [[ "$subversioned" == "true" ]]; then
        echo -e "  ${BOLD}Mode${NC}      subversioned (prefix ~/.local/opt/${package}-${version}/)"
    else
        echo -e "  ${BOLD}Mode${NC}      standard"
    fi
    echo -e "  ${BOLD}Tag${NC}       ${tag}"
    echo ""

    # ── Detección de runs previos del workflow ────────────────────────────────
    # Consulta los runs que coincidan con "{package} @ {sha7}" (run-name del
    # workflow: "📦 <pkg> @ <sha>"). Evita relanzar a ciegas una build que ya
    # está en curso o que ya terminó con éxito para este commit. Cada caso
    # pregunta con read -p (el prompt va a stderr); una respuesta distinta de
    # y/Y aborta sin lanzar nada.
    local raw_runs=""
    raw_runs="$(gh run list --workflow "$WORKFLOW_FILE" -R "$RELEASE_REPO" \
        --limit 100 --json databaseId,displayTitle,status,conclusion,event 2>/dev/null || true)"

    local run_id_curso="" run_id_exitoso=""
    if [[ -n "$raw_runs" && "$raw_runs" != "[]" ]]; then
        run_id_curso="$(printf '%s' "$raw_runs" | jq -r --arg t "${package} @ ${short_sha}" \
            '.[] | select(.displayTitle | contains($t)) | select(.status == "in_progress" or .status == "queued") | .databaseId' 2>/dev/null | head -1 || true)"
        run_id_exitoso="$(printf '%s' "$raw_runs" | jq -r --arg t "${package} @ ${short_sha}" \
            '.[] | select(.displayTitle | contains($t)) | select(.conclusion == "success") | .databaseId' 2>/dev/null | head -1 || true)"
    fi

    local answer=""
    local prompt_shown=false
    if [[ -n "$run_id_curso" ]]; then
        prompt_shown=true
        read -r -p "$(warn "Hay una build EN CURSO de ${package} @ ${short_sha} (run #${run_id_curso}). ¿Relanzar de todos modos? [y/N] ")" answer || answer="n"
    elif [[ -n "$run_id_exitoso" ]]; then
        prompt_shown=true
        read -r -p "$(warn "Ya existe una build EXITOSA de ${package} @ ${short_sha} (run #${run_id_exitoso}). ¿Relanzar de todos modos? [y/N] ")" answer || answer="n"
    fi
    # Solo y/Y relanzan la build. Enter (respuesta vacía) o cualquier otra
    # respuesta aborta: el prompt promete [y/N] con default No. Si no hubo run
    # previo no hay pregunta (prompt_shown=false) y se continúa con el build.
    if [[ "$prompt_shown" == "true" && ( -z "$answer" || ( "$answer" != "y" && "$answer" != "Y" ) ) ]]; then
        info "Build no relanzada. Saliendo."
        exit 0
    fi

    # ── Check / Download / Trigger ────────────────────────────────────────────

    local do_download=false

    info "Checking for existing release..."
    if gh release view "$tag" -R "$RELEASE_REPO" &>/dev/null; then
        ok "Release '${tag}' already exists!"
        do_download=true
    else
        # Buscar releases que coincidan por paquete y versión
        info "Tag exacto '${tag}' no encontrado. Buscando releases por versión..."
        local matching_tag
        if [[ "$subversioned" == "true" ]]; then
            # Solo tags versionados ({pkg}-{ver}-{sha}-subversioned)
            matching_tag="$(gh release list -R "$RELEASE_REPO" --limit 50 --json tagName --jq '.[].tagName' 2>/dev/null | grep -F "${package}-${version}-" | grep -- "-subversioned$" | head -1 || true)"
        else
            # Tags normales ({pkg}-{ver}-{sha}), excluyendo los subversioned
            matching_tag="$(gh release list -R "$RELEASE_REPO" --limit 50 --json tagName --jq '.[].tagName' 2>/dev/null | grep -F "${package}-${version}-" | grep -v -- "-subversioned$" | head -1 || true)"
        fi

        if [[ -n "$matching_tag" ]]; then
            ok "Found existing release: ${matching_tag}"
            tag="$matching_tag"
            do_download=true
        else
            if [[ "$subversioned" == "true" ]]; then
                info "No subversioned release found. Triggering build workflow (job: subversioned)..."
            else
                info "No existing release found. Triggering build workflow (jobs: normal + subversioned)..."
            fi
            echo ""

            # Intentar habilitar el workflow por si está inactivo
            info "Ensuring workflow is enabled..."
            gh workflow enable "$WORKFLOW_FILE" -R "$RELEASE_REPO" 2>/dev/null || true

            local gh_flags=()
            if [[ "$zram" == "true" ]]; then
                gh_flags+=(-f heavy=true)
            fi
            if [[ "$subversioned" == "true" ]]; then
                gh_flags+=(-f jobs=subversioned)
            fi

            local workflow_output
            workflow_output="$(gh workflow run "$WORKFLOW_FILE" -R "$RELEASE_REPO" \
                --ref "$WORKFLOW_REF" \
                -f package_name="$package" -f git_ref="$sha" \
                "${gh_flags[@]}" 2>&1)" || {
                err "Failed to trigger workflow: ${workflow_output}"
                echo ""
                info "Possible solutions:"
                echo "  1. Go to https://github.com/${RELEASE_REPO}/actions and check if the workflow is enabled"
                echo "  2. Run: gh workflow enable ${WORKFLOW_FILE} -R ${RELEASE_REPO}"
                echo "  3. Push a commit to trigger the workflow activation: git commit --allow-empty -m 'activate workflows' && git push"
                echo "  4. Or run workflow manually from the GitHub UI"
                exit 1
            }

            echo ""
            info "Workflow dispatched! Waiting for run ID..."
            sleep 5

            local run_id=""
            run_id="$(gh run list --workflow "$WORKFLOW_FILE" -R "$RELEASE_REPO" \
                --json databaseId --jq '.[0].databaseId' --limit 1 2>/dev/null)" || true

            if [[ -n "$run_id" ]]; then
                if [[ "$subversioned" == "true" ]]; then
                    ok "Workflow started: #${run_id} (modo: subversioned)"
                else
                    ok "Workflow started: #${run_id} (modo: normal + subversioned)"
                fi
                echo ""
                echo -e "  ${BOLD}Monitor:${NC}  gh run watch ${run_id} -R ${RELEASE_REPO}"
                echo -e "  ${BOLD}Status:${NC}   prev-termux status"
                echo -e "  ${BOLD}URL:${NC}      https://github.com/${RELEASE_REPO}/actions/runs/${run_id}"
            else
                warn "Could not retrieve run ID. Check status manually:"
                echo -e "  ${BOLD}  gh run list --workflow ${WORKFLOW_FILE} -R ${RELEASE_REPO}${NC}"
                echo -e "  ${BOLD}  prev-termux status${NC}"
            fi
        fi
    fi

    if $do_download; then
        echo ""
        info "Checking for local artifacts..."
        mkdir -p "${PWD}/output"

        # Buscar si ya existe algún .pkg.tar.xz en output/
        shopt -s nullglob
        LOCAL_FILES=("${PWD}/output/"${package}-*.pkg.tar.*)
        shopt -u nullglob
        if [[ ${#LOCAL_FILES[@]} -gt 0 && -f "${LOCAL_FILES[0]}" ]]; then
            ok "Artifact already downloaded:"
            echo ""
            ls -lh "${PWD}/output/${package}-"*.pkg.tar.* 2>/dev/null
            echo ""
            info "Run this to install:"
            echo "  pacman -U ${PWD}/output/$(basename "${LOCAL_FILES[0]}")"
        else
            info "Downloading artifacts..."

            # Intentar descargar con patrón específico
            if gh release download "$tag" -R "$RELEASE_REPO" \
                --pattern "*.pkg.tar.xz" \
                --dir "${PWD}/output" \
                --skip-existing 2>&1; then
                ok "Artifacts downloaded to ${PWD}/output/"
            else
                # Fallback: descargar todos los assets
                warn "Pattern-specific download had issues; downloading all assets..."
                gh release download "$tag" -R "$RELEASE_REPO" \
                    --dir "${PWD}/output" \
                    --skip-existing 2>&1 || true
                ok "All assets downloaded to ${PWD}/output/"
            fi

            echo ""
            ls -lh "${PWD}/output/"*.pkg.tar.* 2>/dev/null || ls -lh "${PWD}/output/" 2>/dev/null | grep -v '^total' || true
        fi
    fi
}

# ─── Command: subinstall ─────────────────────────────────────────────────────────
# Usage: prev-termux subinstall [<package>|<file.pkg.tar.xz>]
#
# Extracts a .pkg.tar.xz to ~/.local/opt/<pkg>-<version>/ with versioned
# symlinks in ~/.local/bin/<bin>-<version>.
#
# If no argument is given, shows all artifacts in output/ via fzf
# (or a numbered menu if fzf is not installed).
# If a package name is given, first picks the version (all available, newest
# first, via _select_line) and then the mode (subversioned/normal, only asked
# when both exist), and downloads+extracts that release from GitHub.
# If a file is given, extracts it directly.
# NEVER uses pacman — works only with local extraction.
#
cmd_subinstall() {
    local target_file=""
    local pkg_filter=""

    # Si pasaron un argumento
    if [[ -n "${1:-}" ]]; then
        # Si es un archivo existente, usarlo directo (flujo local)
        if [[ -f "$1" ]]; then
            target_file="$1"
        else
            # Es un nombre de paquete → flujo GitHub (descarga de la release)
            pkg_filter="$1"
        fi
    fi

    # ── Flujo local: archivo directo ──────────────────────────────────────────
    if [[ -n "$target_file" ]]; then
        _subinstall_extract "$target_file"
        return 0
    fi

    # ── Flujo local: selección en output/ vía fzf (sin argumento) ─────────────
    if [[ -z "$pkg_filter" ]]; then
        local output_dir="${PWD}/output"
        if [[ ! -d "$output_dir" ]]; then
            die "No output/ directory found. Use: ./scripts/prev-termux subinstall <package>"
        fi

        shopt -s nullglob
        local files=("${output_dir}/"*.pkg.tar.*)
        shopt -u nullglob

        if [[ ${#files[@]} -eq 0 ]]; then
            die "No .pkg.tar.* files found in ${output_dir}. Use: ./scripts/prev-termux subinstall <package>"
        fi

        # Construir mapping nombre_corto → path_completo + symlinks para preview
        local -A name_to_path
        local short_names=()
        local preview_dir
        preview_dir="$(mktemp -d "${TMPDIR}/prev-termux.XXXXXX")"

        local f base_name short_name
        for f in "${files[@]}"; do
            base_name=$(basename "$f")
            # Extraer pkg-version del filename
            # Formato: <pkg>-<version>-<revision>-<arch>.pkg.tar.xz
            short_name=$(echo "$base_name" | sed -E 's/^([a-zA-Z_-]+-[0-9]+(\.[0-9]+)*).*/\1/')
            name_to_path["$short_name"]="$f"
            short_names+=("$short_name")
            # Symlink para preview (nombre_corto → path_completo)
            ln -sf "$f" "${preview_dir}/${short_name}" 2>/dev/null || true
        done

        # Mostrar solo nombres cortos (fzf con preview si está disponible;
        # si no, menú numerado con _select_line)
        local selected_name=""
        if command -v fzf &>/dev/null; then
            selected_name="$(printf '%s\n' "${short_names[@]}" | fzf \
                --prompt='Select package to install: ' \
                --preview "tar -tf '${preview_dir}/{}' 2>/dev/null | head -20" \
                --preview-window='right:60%' \
                2>/dev/null)" || die "No file selected"
        else
            warn "fzf no está instalado; usando menú numerado..."
            selected_name="$(_select_line "Selecciona paquete a instalar: " "${short_names[@]}")" || die "No file selected"
        fi

        target_file="${name_to_path[$selected_name]}"

        # Limpiar directorio temporal
        rm -rf "$preview_dir"

        _subinstall_extract "$target_file"
        return 0
    fi

    # ── Flujo GitHub: descargar la release del paquete ────────────────────────
    # Lista los releases del repo y construye la lista de VERSIONES ÚNICAS del
    # paquete con sus modos disponibles (normal y/o subversioned). Cada versión
    # se extrae del tag con el patrón {pkg}-{ver}-{sha7}(-subversioned)
    # tolerando guiones en {ver} (mismo enfoque de ver_tag) y se ordena por
    # createdAt desc (más reciente primero), no lexicográficamente.
    info "Buscando releases de '${pkg_filter}' en ${RELEASE_REPO}..."
    local releases_json=""
    releases_json="$(gh release list -R "$RELEASE_REPO" --limit 200 \
        --json tagName,createdAt 2>/dev/null || true)"
    if [[ -z "$releases_json" || "$releases_json" == "[]" ]]; then
        die "No se pudo listar releases de ${RELEASE_REPO} (o no hay releases)."
    fi

    # $pkg_re = nombre del paquete escapado para usarlo como texto LITERAL en la
    # regex de test() (jq usa ERE/POSIX, mismo escape que sed): 'libc++' →
    # 'libc\+\+'; sin escapar, los '+' actuarían como cuantificadores y el tag
    # 'libc++-...' no matchearía. startswith() sigue usando el nombre crudo
    # (comparación literal de cadena, sin regex).
    local pkg_re="" tags_txt="" versions_txt=""
    pkg_re="$(_escape_regex "$pkg_filter")"
    tags_txt="$(_release_tags "$releases_json" "$pkg_filter")"
    versions_txt="$(_release_versions "$tags_txt")"
    if [[ -z "$versions_txt" ]]; then
        die "No se encontraron releases de '${pkg_filter}' en ${RELEASE_REPO}. Compílalo primero: ./scripts/prev-termux build ${pkg_filter}"
    fi

    # ── Selección de versión (fzf o menú numerado vía _select_line) ─────────
    # Cada fila TSV: ver | normal | sub | createdAt_máx | tag_normal | tag_sub
    local -a vrows=()
    mapfile -t vrows <<< "$versions_txt"
    local chosen_ver="" chosen_normal="" chosen_sub="" chosen_date=""
    local chosen_tag_n="" chosen_tag_s=""
    local -a labels=()
    local vv="" nn="" ss="" dd="" tn="" ts="" row="" label=""
    for row in "${vrows[@]}"; do
        IFS=$'\t' read -r vv nn ss dd tn ts <<< "$row"
        labels+=("$(_version_label "$pkg_filter" "$vv" "$nn" "$ss")")
    done

    if [[ ${#vrows[@]} -eq 1 ]]; then
        IFS=$'\t' read -r chosen_ver chosen_normal chosen_sub chosen_date chosen_tag_n chosen_tag_s <<< "${vrows[0]}"
        ok "Única versión disponible de '${pkg_filter}': ${chosen_ver}"
    else
        local selected=""
        echo ""
        info "Versiones disponibles de '${pkg_filter}' (${#vrows[@]}, más reciente primero):"
        selected="$(_select_line "Selecciona versión de ${pkg_filter}: " "${labels[@]}")" || \
            die "Selección de versión cancelada o inválida"
        [[ -z "$selected" ]] && die "No se seleccionó ninguna versión"

        # Resolver la línea elegida a su versión con match EXACTO del label
        # (sin parsear regex: robusto ante versiones con guiones).
        chosen_ver=""
        for row in "${vrows[@]}"; do
            IFS=$'\t' read -r vv nn ss dd tn ts <<< "$row"
            if [[ "$(_version_label "$pkg_filter" "$vv" "$nn" "$ss")" == "$selected" ]]; then
                chosen_ver="$vv"; chosen_normal="$nn"; chosen_sub="$ss"
                chosen_date="$dd"; chosen_tag_n="$tn"; chosen_tag_s="$ts"
                break
            fi
        done
        if [[ -z "$chosen_ver" ]]; then
            die "No se pudo resolver la versión seleccionada: '${selected}'"
        fi
        ok "Versión seleccionada: ${chosen_ver}"
    fi

    # ── Diálogo de modo (subversioned vs normal) para la versión elegida ────
    local mode=""
    if [[ "$chosen_normal" == "y" && "$chosen_sub" == "y" ]]; then
        local mode_choice=""
        echo ""
        info "Modos disponibles para '${pkg_filter}' ${chosen_ver}:"
        mode_choice="$(_select_line "Modo para ${pkg_filter} ${chosen_ver}: " "Subversion" "Normal")" || \
            die "Selección de modo cancelada o inválida"
        case "$mode_choice" in
            Subversion) mode="subversioned" ;;
            Normal) mode="normal" ;;
            *) die "Selección de modo inválida: '${mode_choice}'. Saliendo." ;;
        esac
    elif [[ "$chosen_sub" == "y" ]]; then
        echo ""
        info "Solo existe release subversioned para '${pkg_filter}' ${chosen_ver}: ${chosen_tag_s}"
        mode="subversioned"
    elif [[ "$chosen_normal" == "y" ]]; then
        local answer=""
        echo ""
        warn "Este paquete aún no se ha compilado subversionado para la versión ${chosen_ver}."
        warn "Solo existe la release normal: ${chosen_tag_n} (${chosen_date:0:10})"
        read -r -p "$(warn "¿Descargar la release normal de todos modos? [y/N] ")" answer || answer="n"
        if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
            info "Descarga cancelada. Saliendo."
            exit 0
        fi
        mode="normal"
    else
        die "No hay releases de '${pkg_filter}' ${chosen_ver} (inconsistencia interna)."
    fi

    # ── Descarga del .pkg.tar.xz a $TMPDIR con cross-check de paquete ────────
    # (nunca output/; --clobber, sin --skip-existing: así el artifact descargado
    # es SIEMPRE el de la versión+modo elegidos).
    #
    # Candidatos: las tags de EXACTAMENTE la versión+modo elegidos (puede haber
    # varias si la misma versión se compiló desde commits distintos), de más
    # reciente a más antigua.
    #
    # Colisión de prefijos: el filtro jq (startswith($p + "-") + regex
    # ^$p-.+-[0-9a-f]{7}$) matchea también paquetes cuyo nombre empieza por el
    # pedido + guión: 'python' matchea python-numpy-*, python-pillow-*. Aunque
    # _release_tags descarta las versiones que no empiezan por dígito, la
    # defensa final (Opción A) es descargar el artifact y cruzarlo con
    # _artifact_version_for_pkg (validación desde la izquierda); si ningún
    # artifact pertenece a $pkg_filter, se descarta el tag y se prueba el
    # siguiente candidato de la misma versión.
    local -a candidate_tags=()
    mapfile -t candidate_tags <<< "$(printf '%s' "$releases_json" | jq -r --arg p "$pkg_filter" --arg pr "$pkg_re" --arg v "$chosen_ver" --arg m "$mode" '
        [ .[] | select(.tagName | startswith($p + "-" + $v + "-")) |
                 select(.tagName | test("^" + $pr + "-.+-[0-9a-f]{7}(-subversioned)?$")) |
                 select(if $m == "normal" then (.tagName | test("-subversioned$") | not)
                                          else (.tagName | test("-subversioned$")) end) ]
        | sort_by(.createdAt) | reverse | .[].tagName
    ' 2>/dev/null || true)"

    local found_tag="" tmpdir="" candidate=""
    local -a good_artifacts=()
    for candidate in "${candidate_tags[@]}"; do
        [[ -z "$candidate" ]] && continue
        tmpdir="$(mktemp -d "${TMPDIR}/prev-termux-sub.XXXXXX")"
        info "Descargando artifacts de '${candidate}' a ${tmpdir}/..."
        if ! gh release download "$candidate" -R "$RELEASE_REPO" \
                --pattern "*.pkg.tar.xz" --dir "$tmpdir" --clobber >/dev/null 2>&1; then
            rm -rf "$tmpdir"
            warn "Fallo al descargar artifacts de la release '${candidate}'; probando siguiente candidato."
            continue
        fi

        shopt -s nullglob
        local artifacts=("$tmpdir"/*.pkg.tar.xz)
        shopt -u nullglob
        if [[ ${#artifacts[@]} -eq 0 ]]; then
            rm -rf "$tmpdir"
            warn "La release '${candidate}' no contiene artifacts .pkg.tar.xz; probando siguiente candidato."
            continue
        fi

        # Cross-check: quedarse solo con artifacts que pertenecen al paquete
        # pedido (validación desde la izquierda con $pkg como ancla; tolera
        # versiones con guiones como libedit-20210216-3.1). Además se compara
        # la versión del artifact contra la versión del TAG (ver_tag, extraída
        # tolerando guiones) para descartar artifacts de la versión equivocada.
        # Si ninguno pertenece, la release es de OTRO paquete → descartarla.
        # $pkg_re ya está definido (función): se usa en ver_tag para tratar el
        # nombre del paquete como texto literal (libc++ → libc\+\+).
        local ver_tag=""
        ver_tag="$(printf '%s' "$candidate" | sed -E "s/^${pkg_re}-(.*)-[0-9a-f]{7}(-subversioned)?$/\1/" || true)"

        # matched guarda "path|version": la versión verificada por el cross-check
        # se reutiliza al extraer (evita re-parsear el nombre, que truncaría
        # libedit-20210216-3.1 → pkg libedit-20210216).
        local -a matched=()
        local a="" artifact_ver="" a_base=""
        for a in "${artifacts[@]}"; do
            a_base="$(basename "$a")"
            if artifact_ver="$(_artifact_version_for_pkg "$a_base" "$pkg_filter")"; then
                if [[ -n "$ver_tag" && "$artifact_ver" != "$ver_tag" ]]; then
                    warn "Artifact '${a_base}' es de '${pkg_filter}' pero su versión '${artifact_ver}' no coincide con el tag '${ver_tag}'; descartando."
                else
                    matched+=("${a}|${artifact_ver}")
                fi
            else
                case "$a_base" in
                    "${pkg_filter}"-*|"${pkg_filter}"_*)
                        # Comparte prefijo con el paquete pedido pero no es él:
                        # colisión real (python vs python-numpy) → sospecha.
                        warn "Artifact '${a_base}' comparte prefijo con '${pkg_filter}' (posible colisión real: python vs python-numpy); descartando."
                        ;;
                    *)
                        # No comparte prefijo: es una dependencia normal del
                        # paquete (cada release sube los artifacts de todas sus
                        # deps) → rechazo esperado, sin alarma.
                        info "Artifact '${a_base}' no pertenece a '${pkg_filter}' (dependencia normal); ignorando."
                        ;;
                esac
            fi
        done

        if [[ ${#matched[@]} -eq 0 ]]; then
            rm -rf "$tmpdir"
            warn "La release '${candidate}' no contiene artifacts de '${pkg_filter}'; probando siguiente candidato."
            continue
        fi

        found_tag="$candidate"
        good_artifacts=("${matched[@]}")
        break
    done

    if [[ -z "$found_tag" ]]; then
        die "No se encontró ninguna release de '${pkg_filter}' ${chosen_ver} cuyos artifacts sean realmente de ese paquete (posible colisión de prefijo: python-numpy, python-pillow...). Compílalo primero: ./scripts/prev-termux build ${pkg_filter}"
    fi

    # ── Extraer cada artifact verificado ──────────────────────────────────────
    # Se pasa el pkg pedido + la versión verificada por el cross-check (no se
    # re-parsea el nombre: _parse_artifact_name truncaría libedit-20210216-3.1
    # → pkg 'libedit-20210216', creando symlinks <bin>-3.1 incorrectos).
    local f
    for f in "${good_artifacts[@]}"; do
        _subinstall_extract "${f%%|*}" "$pkg_filter" "${f#*|}"
    done
    rm -rf "$tmpdir"
    ok "Instalación completada desde '${found_tag}'."
}


# ─── _select_line ───────────────────────────────────────────────────────────────
# Muestra las opciones recibidas COMO ARGUMENTOS y devuelve por stdout la
# seleccionada. Usa fzf si está disponible; si no, cae a un menú numerado con read.
# El menú numerado se imprime por stderr (no ensucia stdout) y la lectura se hace
# desde /dev/tty cuando stdin es un terminal, o desde stdin en caso de
# automatización/pipe. NO debe invocarse vía pipe (`printf ... | _select_line`)
# porque mapfile drena stdin hasta EOF y el read posterior recibe EOF al instante.
# Devuelve vacío (exit 1) si no hay opciones o la selección es inválida/cancelada.
_select_line() {
    local prompt="${1:-Select: }"
    shift || true
    local -a opts=("$@")
    if [[ ${#opts[@]} -eq 0 ]]; then
        return 1
    fi

    if command -v fzf &>/dev/null; then
        printf '%s\n' "${opts[@]}" | fzf --prompt="$prompt" 2>/dev/null
        return $?
    fi

    # Fallback: menú numerado sin fzf
    local i=0 o=""
    printf '%s\n' "Opciones disponibles:" >&2
    for o in "${opts[@]}"; do
        i=$((i + 1))
        printf '  %d) %s\n' "$i" "$o" >&2
    done
    printf '%s' "$prompt" >&2

    local choice=""
    if [[ -t 0 ]] && [[ -r /dev/tty ]]; then
        read -r choice </dev/tty || return 1
    else
        read -r choice || return 1
    fi
    if [[ ! "$choice" =~ ^[0-9]+$ ]]; then
        return 1
    fi
    if (( choice < 1 || choice > ${#opts[@]} )); then
        return 1
    fi
    printf '%s\n' "${opts[$((choice - 1))]}"
}


# ─── Command: install ───────────────────────────────────────────────────────────
# Usage: prev-termux install <package> [<version>] [--arch <arch>]
#
# Instala una build NORMAL (no subversioned) de <package> con el gestor de
# paquetes detectado (pacman o apt):
#   • Primero se elige la versión (fzf o menú numerado vía _select_line) entre
#     las que tienen release NORMAL, ordenadas por createdAt desc (más reciente
#     primero). Con <version> explícito se salta el selector.
#   • pacman → descarga el .pkg.tar.xz de esa versión a $TMPDIR y ejecuta
#     `pacman -U <file>`.
#   • apt    → igual pero con el .deb y `apt install <file>`.
# NUNCA pasa flags de auto-yes (--noconfirm / -y): el gestor pide confirmación.
# --arch <arch> restringe el patrón de descarga (ej: --arch aarch64).
#
cmd_install() {
    local package="" version="" arch=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --arch)
                [[ -z "${2:-}" ]] && die "--arch requires a value"
                arch="$2"; shift 2
                ;;
            --arch=*) arch="${1#*=}"; shift ;;
            -*)
                die "Unknown argument: $1"
                ;;
            *)
                if [[ -z "$package" ]]; then
                    package="$1"
                elif [[ -z "$version" ]]; then
                    version="$1"
                else
                    die "Unknown argument: $1"
                fi
                shift
                ;;
        esac
    done

    [[ -z "$package" ]] && die "Usage: prev-termux install <package> [<version>] [--arch <arch>]"

    # ── Detección del gestor de paquetes ────────────────────────────────────
    local has_pacman=false has_apt=false
    command -v pacman &>/dev/null && has_pacman=true
    command -v apt &>/dev/null && has_apt=true

    local pkg_manager=""
    if [[ "$has_pacman" == "true" && "$has_apt" == "true" ]]; then
        read -r -p "Ambos gestores disponibles (pacman/apt). ¿Cuál usar? [pacman] " pkg_manager || pkg_manager="pacman"
        pkg_manager="${pkg_manager:-pacman}"
        case "$pkg_manager" in
            pacman|apt) : ;;
            *) die "Gestor de paquetes inválido: '${pkg_manager}'. Usa 'pacman' o 'apt'." ;;
        esac
    elif [[ "$has_pacman" == "true" ]]; then
        pkg_manager="pacman"
    elif [[ "$has_apt" == "true" ]]; then
        pkg_manager="apt"
    else
        die "No package manager found (pacman or apt)"
    fi

    # ── Versiones NORMAL disponibles y selección de versión ─────────────────
    # Construye la lista de VERSIONES ÚNICAS del paquete (igual que subinstall,
    # reutilizando _release_tags/_release_versions) y se queda solo con las que
    # tienen release NORMAL (col normal == "y"). La selección se hace con
    # _select_line (fzf o menú numerado), ordenada por createdAt desc (más
    # reciente primero). Si se pasa <version>, se salta el selector y se usa esa
    # versión exacta.
    info "Buscando releases normal de '${package}' en ${RELEASE_REPO}..."
    local releases_json=""
    releases_json="$(gh release list -R "$RELEASE_REPO" --limit 200 \
        --json tagName,createdAt 2>/dev/null || true)"
    if [[ -z "$releases_json" || "$releases_json" == "[]" ]]; then
        die "No se pudo listar releases de ${RELEASE_REPO} (o no hay releases)."
    fi

    # $pkg_re escapado para test() (texto literal; jq ERE/POSIX, mismo escape que
    # sed): 'libc++' → 'libc\+\+'. startswith() usa el nombre crudo.
    local pkg_re="" tags_txt="" versions_txt=""
    pkg_re="$(_escape_regex "$package")"
    tags_txt="$(_release_tags "$releases_json" "$package")"
    versions_txt="$(_release_versions "$tags_txt")"

    # Filtrar solo filas con release NORMAL (col 2 == "y").
    # Cada fila TSV: ver | normal | sub | createdAt_máx | tag_normal | tag_sub
    local -a vrows=()
    local vv="" nn="" ss="" dd="" tn="" ts="" row=""
    while IFS=$'\t' read -r vv nn ss dd tn ts; do
        [[ -n "$vv" && "$nn" == "y" ]] && vrows+=("$vv	$nn	$ss	$dd	$tn	$ts")
    done <<< "$versions_txt"

    if [[ ${#vrows[@]} -eq 0 ]]; then
        die "No hay release normal de '${package}'${version:+ (versión '${version}')} en ${RELEASE_REPO}. Compílalo primero: ./scripts/prev-termux build ${package}"
    fi

    local chosen_ver="" chosen_normal="" chosen_sub="" chosen_date=""
    local chosen_tag_n="" chosen_tag_s=""
    if [[ -n "$version" ]]; then
        # <version> explícito: buscar la fila NORMAL de esa versión exacta
        chosen_ver=""
        for row in "${vrows[@]}"; do
            IFS=$'\t' read -r vv nn ss dd tn ts <<< "$row"
            if [[ "$vv" == "$version" ]]; then
                chosen_ver="$vv"; chosen_normal="$nn"; chosen_sub="$ss"
                chosen_date="$dd"; chosen_tag_n="$tn"; chosen_tag_s="$ts"
                break
            fi
        done
        if [[ -z "$chosen_ver" ]]; then
            local available=""
            available="$(printf '%s\n' "${vrows[@]}" | cut -d$'\t' -f1 | paste -sd, - 2>/dev/null || true)"
            die "No hay release normal de '${package}' versión '${version}' en ${RELEASE_REPO}. Disponibles: ${available}"
        fi
        ok "Versión solicitada: ${chosen_ver}"
    elif [[ ${#vrows[@]} -eq 1 ]]; then
        IFS=$'\t' read -r chosen_ver chosen_normal chosen_sub chosen_date chosen_tag_n chosen_tag_s <<< "${vrows[0]}"
        ok "Única versión normal disponible de '${package}': ${chosen_ver}"
    else
        # Selección interactiva con _select_line (fzf o menú numerado)
        local -a labels=()
        local label=""
        for row in "${vrows[@]}"; do
            IFS=$'\t' read -r vv nn ss dd tn ts <<< "$row"
            labels+=("$(_version_label "$package" "$vv" "$nn" "$ss")")
        done
        local selected=""
        echo ""
        info "Versiones normales disponibles de '${package}' (${#vrows[@]}, más reciente primero):"
        selected="$(_select_line "Selecciona versión de ${package}: " "${labels[@]}")" || \
            die "Selección de versión cancelada o inválida"
        [[ -z "$selected" ]] && die "No se seleccionó ninguna versión"

        # Resolver la línea elegida a su versión con match EXACTO del label
        chosen_ver=""
        for row in "${vrows[@]}"; do
            IFS=$'\t' read -r vv nn ss dd tn ts <<< "$row"
            if [[ "$(_version_label "$package" "$vv" "$nn" "$ss")" == "$selected" ]]; then
                chosen_ver="$vv"; chosen_normal="$nn"; chosen_sub="$ss"
                chosen_date="$dd"; chosen_tag_n="$tn"; chosen_tag_s="$ts"
                break
            fi
        done
        if [[ -z "$chosen_ver" ]]; then
            die "No se pudo resolver la versión seleccionada: '${selected}'"
        fi
        ok "Versión seleccionada: ${chosen_ver}"
    fi

    # ── Descarga del artifact a $TMPDIR con cross-check de paquete ────────────
    # Candidatos: las tags NORMAL de EXACTAMENTE la versión elegida (puede haber
    # varias si la misma versión se compiló desde commits distintos), de más
    # reciente a más antigua.
    #
    # Colisión de prefijos: el filtro jq matchea también python-numpy-*,
    # python-pillow-* al buscar 'python'. Aunque _release_tags descarta las
    # versiones que no empiezan por dígito, la defensa final (Opción A) es
    # descargar el artifact y cruzarlo con _artifact_version_for_pkg (validación
    # desde la izquierda); si ningún artifact pertenece a $package, se descarta
    # el tag y se prueba el siguiente candidato.
    local pattern="*"
    if [[ -n "$arch" ]]; then
        pattern="*${arch}"
    fi
    if [[ "$pkg_manager" == "pacman" ]]; then
        pattern="${pattern}.pkg.tar.xz"
    else
        pattern="${pattern}.deb"
    fi

    local -a candidates=()
    mapfile -t candidates <<< "$(printf '%s' "$releases_json" | jq -r --arg p "$package" --arg pr "$pkg_re" --arg v "$chosen_ver" '
        [ .[] | select(.tagName | startswith($p + "-" + $v + "-")) |
                 select(.tagName | test("^" + $pr + "-.+-[0-9a-f]{7}$")) |
                 select(.tagName | test("-subversioned$") | not) ]
        | sort_by(.createdAt) | reverse | .[].tagName
    ' 2>/dev/null || true)"

    local tag="" ver="" artifact="" found_tag="" tmpdir="" candidate=""
    local -a artifacts=()

    for candidate in "${candidates[@]}"; do
        [[ -z "$candidate" ]] && continue
        tmpdir="$(mktemp -d "${TMPDIR}/prev-termux-install.XXXXXX")"
        info "Descargando artifacts de '${candidate}' (gestor: ${pkg_manager}, patrón: ${pattern}) a ${tmpdir}/..."
        if ! gh release download "$candidate" -R "$RELEASE_REPO" \
                --pattern "$pattern" --dir "$tmpdir" --clobber >/dev/null 2>&1; then
            rm -rf "$tmpdir"
            warn "Fallo al descargar artifacts de la release '${candidate}'; probando siguiente candidato."
            continue
        fi

        shopt -s nullglob
        artifacts=("$tmpdir"/${pattern})
        shopt -u nullglob
        if [[ ${#artifacts[@]} -eq 0 ]]; then
            rm -rf "$tmpdir"
            warn "La release '${candidate}' no contiene artifacts con patrón '${pattern}'; probando siguiente candidato."
            continue
        fi

        # Cross-check: al menos un artifact debe pertenecer al paquete pedido
        # (validación desde la izquierda; tolera versiones con guiones como
        # libedit-20210216-3.1). La versión del artifact debe coincidir con la
        # del TAG (ver_tag). Si ninguno pertenece → siguiente candidato.
        local ver_tag="" good="" a="" artifact_ver="" a_base=""
        ver_tag="$(printf '%s' "$candidate" | sed -E "s/^${pkg_re}-(.*)-[0-9a-f]{7}(-subversioned)?$/\1/" || true)"
        for a in "${artifacts[@]}"; do
            a_base="$(basename "$a")"
            if artifact_ver="$(_artifact_version_for_pkg "$a_base" "$package")"; then
                if [[ -n "$ver_tag" && "$artifact_ver" != "$ver_tag" ]]; then
                    warn "Artifact '${a_base}' es de '${package}' pero su versión '${artifact_ver}' no coincide con el tag '${ver_tag}'; descartando."
                else
                    good="$a"
                    break
                fi
            else
                case "$a_base" in
                    "${package}"-*|"${package}"_*)
                        # Comparte prefijo con el paquete pedido pero no es él:
                        # colisión real (python vs python-numpy) → sospecha.
                        warn "Artifact '${a_base}' comparte prefijo con '${package}' (posible colisión real: python vs python-numpy); descartando."
                        ;;
                    *)
                        # Dependencia normal del paquete → rechazo esperado.
                        info "Artifact '${a_base}' no pertenece a '${package}' (dependencia normal); ignorando."
                        ;;
                esac
            fi
        done

        if [[ -z "$good" ]]; then
            rm -rf "$tmpdir"
            warn "Los artifacts de '${candidate}' no son de '${package}' (posible colisión de prefijo: python-numpy, python-pillow...). Descartando; probando siguiente candidato."
            continue
        fi

        found_tag="$candidate"
        tag="$candidate"
        artifact="$good"
        break
    done

    if [[ -z "$found_tag" ]]; then
        die "No se encontró ninguna release de '${package}' ${chosen_ver} cuyos artifacts sean realmente de ese paquete (posible colisión de prefijo). Compílalo primero: ./scripts/prev-termux build ${package}"
    fi

    ver="$(printf '%s' "$tag" | sed -E "s/^${pkg_re}-(.*)-[0-9a-f]{7}$/\1/")"

    if [[ ${#artifacts[@]} -gt 1 ]]; then
        warn "Varios artifacts coinciden con '${pattern}'; instalando: $(basename "$artifact")"
    fi

    # ── Instalación (SIN auto-yes: el gestor pide confirmación) ─────────────
    echo ""
    info "Instalando ${package} ${ver} (${pkg_manager}): $(basename "$artifact")"
    if [[ "$pkg_manager" == "pacman" ]]; then
        pacman -U "$artifact" || {
            err "pacman no completó la instalación. El artifact queda en: ${artifact}"
            exit 1
        }
    else
        apt install "$artifact" || {
            err "apt no completó la instalación. El artifact queda en: ${artifact}"
            exit 1
        }
    fi
    rm -rf "$tmpdir"
    ok "Instalación de '${package}' ${ver} completada con ${pkg_manager}."
}


# ─── Command: switch ────────────────────────────────────────────────────────────
# Usage: prev-termux switch [<package>]
#
# Cambia la versión subversionada ACTIVA de <package> en $PREFIX/bin.
# Las versiones subversionadas viven en $PREV_TERMUX_INSTALL_DIR/<pkg>-<ver>/
# (creadas por 'subinstall'). Al elegir una versión se (re)crean los symlinks
# de TODOS sus binarios en $PREFIX/bin (criterio simple: si el paquete tiene
# varios binarios en bin/, se enlazan todos).
# Sin argumento: elige el paquete (fzf) entre los instalados.
# Con fzf ausente: cae a un menú numerado con read.
#
cmd_switch() {
    local package="${1:-}"
    local prefix="${PREFIX:-/data/data/com.termux/files/usr}"
    local install_dir="${PREV_TERMUX_INSTALL_DIR:-${HOME}/.local/opt}"
    local bin_dir="${prefix}/bin"

    # ── Sin paquete: elegirlo entre los instalados ───────────────────────────
    if [[ -z "$package" ]]; then
        shopt -s nullglob
        local dirs=("$install_dir"/*/)
        shopt -u nullglob
        if [[ ${#dirs[@]} -eq 0 ]]; then
            die "No hay paquetes subversionados instalados en ${install_dir}. Usa: prev-termux subinstall <package>"
        fi
        # Recuperar el nombre del paquete de cada directorio <pkg>-<ver>/
        local d="" bname="" parsed_pkg=""
        local -a pkg_names=()
        for d in "${dirs[@]}"; do
            bname="$(basename "${d%/}")"
            parsed_pkg="$(echo "$bname" | sed -E 's/^(.*)[-_][0-9][^-_]*$/\1/')"
            if [[ -n "$parsed_pkg" && "$parsed_pkg" != "$bname" ]]; then
                pkg_names+=("$parsed_pkg")
            fi
        done
        if [[ ${#pkg_names[@]} -eq 0 ]]; then
            die "No se pudieron identificar paquetes en ${install_dir}."
        fi
        local unique=""
        unique="$(printf '%s\n' "${pkg_names[@]}" | sort -u)"
        # Convertir la lista multi-línea en array para _select_line (no vía pipe)
        local -a unique_opts=()
        mapfile -t unique_opts <<< "$unique"
        local chosen=""
        chosen="$(_select_line "Selecciona paquete: " "${unique_opts[@]}")" || die "Selección cancelada o inválida"
        [[ -z "$chosen" ]] && die "No se seleccionó ningún paquete"
        package="$chosen"
    fi

    # ── Versiones instaladas del paquete ─────────────────────────────────────
    shopt -s nullglob
    local pkg_dirs=("$install_dir"/"$package"-*/)
    shopt -u nullglob
    if [[ ${#pkg_dirs[@]} -eq 0 ]]; then
        die "No hay versiones subversionadas instaladas de '${package}'. Usa: prev-termux subinstall ${package}"
    fi

    # ── Detectar la versión ACTUAL (a qué dir apunta el symlink) ─────────────
    local current=""
    if [[ -L "${bin_dir}/${package}" ]]; then
        local resolved=""
        resolved="$(readlink -f "${bin_dir}/${package}" 2>/dev/null || true)"
        if [[ -n "$resolved" ]]; then
            local d=""
            for d in "${pkg_dirs[@]}"; do
                if [[ "$resolved" == "${d%/}"* ]]; then
                    current="$(basename "${d%/}")"
                    break
                fi
            done
        fi
    fi

    # ── Selección de versión (fzf o menú numerado) ──────────────────────────
    local entry="" label=""
    local -a labels=()
    for d in "${pkg_dirs[@]}"; do
        entry="$(basename "${d%/}")"
        if [[ "$entry" == "$current" ]]; then
            label="${entry} (actual)"
        else
            label="${entry}"
        fi
        labels+=("$label")
    done

    local selected=""
    selected="$(_select_line "Selecciona versión de ${package}: " "${labels[@]}")" || die "Selección cancelada o inválida"
    [[ -z "$selected" ]] && die "No se seleccionó ninguna versión"
    # Quitar la marca (actual) si se eligió la versión ya activa
    selected="${selected% (actual)}"

    # ── Crear symlinks en $PREFIX/bin para TODOS los binarios ────────────────
    local target_dir="$install_dir/${selected}"
    local target_bin="${target_dir}/bin"
    if [[ ! -d "$target_bin" ]]; then
        die "No hay bin/ en ${target_dir}. Instalación incompleta de '${selected}'."
    fi

    mkdir -p "$bin_dir"
    shopt -s nullglob
    local binaries=("$target_bin"/*)
    shopt -u nullglob
    if [[ ${#binaries[@]} -eq 0 ]]; then
        die "No se encontraron binarios en ${target_bin}"
    fi

    local bin_file="" bname="" created=0
    for bin_file in "${binaries[@]}"; do
        bname="$(basename "$bin_file")"
        ln -sfn "$bin_file" "${bin_dir}/${bname}"
        ok "Symlink: ${bin_dir}/${bname} → ${bin_file}"
        created=$((created + 1))
    done

    echo ""
    ok "Versión activa de '${package}': ${selected} (${created} symlink(s) en ${bin_dir}/)"
}


# ─── Command: fetch ──────────────────────────────────────────────────────────────
# Usage: prev-termux fetch <package> [version] [--arch <arch>] [--subversioned] [--out <dir>]
#
# Descarga del PrevTermux Store (pool de GitHub Releases prev-termux-pool-<arch>,
# indexado por manifest.json) el .deb de una versión — y el .pkg.tar.xz si el
# paquete es objetivo (entrada con campo pkg_tar en el manifest).
# Sin versión: descarga la única disponible; si hay varias, las lista.
# --arch          arquitectura del pool (default: aarch64; fallback arch=all)
# --subversioned  busca el artifact subversioned (mode=subversioned)
# --out           directorio de descarga (default: ./output)
#
cmd_fetch() {
    local pkg="" ver="" arch="aarch64" mode="normal" out_dir="${PWD}/output"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --arch)
                [[ -z "${2:-}" ]] && die "--arch requires a value"
                arch="$2"; shift 2
                ;;
            --arch=*) arch="${1#*=}"; shift ;;
            --subversioned) mode="subversioned"; shift ;;
            --out)
                [[ -z "${2:-}" ]] && die "--out requires a value"
                out_dir="$2"; shift 2
                ;;
            --out=*) out_dir="${1#*=}"; shift ;;
            -*)
                die "Unknown argument: $1"
                ;;
            *)
                if [[ -z "$pkg" ]]; then
                    pkg="$1"
                elif [[ -z "$ver" ]]; then
                    ver="$1"
                else
                    die "Unknown argument: $1"
                fi
                shift
                ;;
        esac
    done

    [[ -z "$pkg" ]] && die "Usage: prev-termux fetch <package> [version] [--arch <arch>] [--subversioned] [--out <dir>]"

    local pool_tag="prev-termux-pool-${arch}"
    info "Consultando pool '${pool_tag}' del repo ${RELEASE_REPO} (mode=${mode})..."

    # ── 1. Manifest del pool ──
    local tmpdir
    tmpdir="$(mktemp -d "${TMPDIR}/prev-termux-fetch.XXXXXX")"
    if ! gh release download "$pool_tag" -R "$RELEASE_REPO" \
            --pattern manifest.json --dir "$tmpdir" >/dev/null 2>&1; then
        rm -rf "$tmpdir"
        die "Pool '${pool_tag}' no existe o no responde. Verifica: gh release view ${pool_tag} -R ${RELEASE_REPO}"
    fi
    local manifest_file="$tmpdir/manifest.json"
    if [[ ! -s "$manifest_file" ]]; then
        rm -rf "$tmpdir"
        die "Pool '${pool_tag}' no contiene un manifest.json"
    fi

    # ── 2. Buscar entradas (pkg + mode; fallback arch=all para deps
    #       platform-independent, igual que store-lib.sh) ──
    local entries
    entries="$(jq -c --arg pkg "$pkg" --arg mode "$mode" \
        '[.entries[] | select(.pkg==$pkg and .mode==$mode)]' "$manifest_file" 2>/dev/null || true)"
    if [[ "$(printf '%s' "$entries" | jq 'length' 2>/dev/null || echo 0)" == "0" && "$arch" != "all" ]]; then
        entries="$(jq -c --arg pkg "$pkg" --arg mode "$mode" \
            '[.entries[] | select(.pkg==$pkg and .arch=="all" and .mode==$mode)]' "$manifest_file" 2>/dev/null || true)"
    fi
    if [[ "$(printf '%s' "$entries" | jq 'length' 2>/dev/null || echo 0)" == "0" ]]; then
        rm -rf "$tmpdir"
        die "No hay entradas para '${pkg}' (mode=${mode}) en el pool '${pool_tag}'. Prueba --subversioned o --arch."
    fi

    # ── 3. Seleccionar entrada ──
    local entry=""
    if [[ -z "$ver" ]]; then
        local count
        count="$(printf '%s' "$entries" | jq 'length')"
        if [[ "$count" -gt 1 ]]; then
            info "Varias versiones de '${pkg}' disponibles en el pool (mode=${mode}):"
            printf '%s\n' "$entries" | jq -r '.[] | "  " + .ver + "  " + (.asset | gsub(":"; "-"))'
            rm -rf "$tmpdir"
            die "Especifica la versión: prev-termux fetch ${pkg} <version> [--arch ${arch}]"
        fi
        entry="$(printf '%s' "$entries" | jq -c '.[0]')"
    else
        entry="$(printf '%s' "$entries" | jq -c --arg v "$ver" '.[] | select(.ver==$v)' 2>/dev/null | head -n 1 || true)"
        if [[ -z "$entry" ]]; then
            local available
            available="$(printf '%s' "$entries" | jq -r '.[].ver' | paste -sd, - 2>/dev/null)"
            rm -rf "$tmpdir"
            die "Versión '${ver}' de '${pkg}' no encontrada en '${pool_tag}' (mode=${mode}). Disponibles: ${available}"
        fi
    fi

    local asset sha256 ver_disp
    asset="$(printf '%s' "$entry" | jq -r '.asset // ""')"
    # Legacy compatibility: epoch Debian en el nombre del asset (p.ej.
    # ca-certificates-java_1:2025.05.20_all.deb). store-publish.sh normaliza
    # ':' → '-' en el pool; aquí se aplica el MISMO saneo para tolerar manifests
    # legacy/manuales ('gh release download --pattern' falla con ':' en el
    # nombre). Idempotente; el match del manifest es por .ver.
    asset="${asset//:/-}"
    sha256="$(printf '%s' "$entry" | jq -r '.sha256 // ""')"
    ver_disp="$(printf '%s' "$entry" | jq -r '.ver // ""')"
    if [[ -z "$asset" || -z "$sha256" ]]; then
        rm -rf "$tmpdir"
        die "Entrada inválida en el manifest del pool: ${entry}"
    fi

    # ── 4. Descargar .deb + verificar sha256 ──
    mkdir -p "$out_dir"
    info "Descargando ${asset} (${pkg} ${ver_disp}, mode=${mode}) a ${out_dir}/..."
    if ! gh release download "$pool_tag" -R "$RELEASE_REPO" \
            --pattern "$asset" --dir "$out_dir" --clobber >/dev/null 2>&1; then
        rm -rf "$tmpdir"
        die "Fallo al descargar ${asset} del pool '${pool_tag}'"
    fi
    local got
    got="$(sha256sum "$out_dir/$asset" | cut -d' ' -f1)"
    if [[ "$got" != "$sha256" ]]; then
        rm -f "$out_dir/$asset"
        rm -rf "$tmpdir"
        die "Checksum erróneo para ${asset}: esperado ${sha256}, obtenido ${got}"
    fi
    ok "Descargado y verificado: ${out_dir}/${asset}"

    # ── 5. .pkg.tar.xz si es paquete objetivo (campo pkg_tar) ──
    local pkg_tar pkg_tar_sha
    pkg_tar="$(printf '%s' "$entry" | jq -r '.pkg_tar // ""')"
    # Mismo saneo ':' → '-' que el .deb (pkg_tar deriva del nombre del asset)
    pkg_tar="${pkg_tar//:/-}"
    pkg_tar_sha="$(printf '%s' "$entry" | jq -r '.pkg_tar_sha256 // ""')"
    if [[ -n "$pkg_tar" && -n "$pkg_tar_sha" ]]; then
        info "Paquete objetivo — descargando ${pkg_tar}..."
        if ! gh release download "$pool_tag" -R "$RELEASE_REPO" \
                --pattern "$pkg_tar" --dir "$out_dir" --clobber >/dev/null 2>&1; then
            rm -rf "$tmpdir"
            die "Fallo al descargar ${pkg_tar} del pool '${pool_tag}'"
        fi
        got="$(sha256sum "$out_dir/$pkg_tar" | cut -d' ' -f1)"
        if [[ "$got" != "$pkg_tar_sha" ]]; then
            rm -f "$out_dir/$pkg_tar"
            rm -rf "$tmpdir"
            die "Checksum erróneo para ${pkg_tar}: esperado ${pkg_tar_sha}, obtenido ${got}"
        fi
        ok "Descargado y verificado: ${out_dir}/${pkg_tar}"
        echo ""
        info "Instala con: prev-termux subinstall ${out_dir}/${pkg_tar}"
    fi

    rm -rf "$tmpdir"
}

# ─── Command: status ─────────────────────────────────────────────────────────────
# Usage: prev-termux status [<package>]
#
# Shows the 20 most recent workflow runs for the build pipeline.
# Optionally filter runs by package name (matched case-insensitively).
#
cmd_status() {
    local filter="${1:-}"
    local limit=20

    # ANSI colors for status indicators
    local green=$'\033[0;32m'
    local red=$'\033[0;31m'
    local yellow=$'\033[1;33m'
    local gray=$'\033[0;90m'
    local reset=$'\033[0m'

    local raw
    raw="$(gh run list --workflow "$WORKFLOW_FILE" -R "$RELEASE_REPO" \
        --limit "$limit" \
        --json displayTitle,status,conclusion,createdAt,updatedAt 2>/dev/null)" || {
        die "Failed to fetch workflow runs"
    }

    if [[ -z "$raw" || "$raw" == "[]" ]]; then
        info "No runs found"
        return
    fi

    # Aplicar filtro
    if [[ -n "$filter" ]]; then
        local filtered
        filtered="$(echo "$raw" | jq -c --arg f "$filter" '[.[] | select(.displayTitle | test($f; "i"))]' 2>/dev/null)"
        if [[ -z "$filtered" || "$filtered" == "[]" ]]; then
            info "No runs found for '$filter'"
            return
        fi
        raw="$filtered"
    fi

    echo "  STATUS  PACKAGE                  TIME"
    echo "  ──────────────────────────────────────────────"
    # Un solo jq que procesa TODO y genera el output formateado
    echo "$raw" | jq -r '
        def icon:
            if .conclusion == "success" then "S"
            elif .conclusion == "failure" then "F"
            elif .conclusion == "cancelled" then "T"
            elif .conclusion == "skipped" then "K"
            elif .status == "in_progress" or .conclusion == null then "R"
            else "?"
            end;
        def elapsed:
            if .createdAt then
                ((if .status == "completed" and .updatedAt then (.updatedAt | fromdateiso8601) else now end) - (.createdAt | fromdateiso8601)) as $sec
                | if $sec < 0 then "-"
                  else
                    (($sec / 3600 | floor) | tostring) as $h
                    | (($sec % 3600 / 60 | floor) | tostring) as $m
                    | (($sec % 60 | floor) | tostring) as $s
                    | (if $h != "0" then $h + "h " else "" end) + (if $m != "0" then $m + "m " else "" end) + $s + "s"
                  end
            else "-"
            end;
        def trunc: .[0:22] + if length > 22 then "…" else "" end;
        .[] | "\(icon) \(.displayTitle | trunc) \(elapsed)"
    ' | sed \
        -e "s/^S /${green}  ✓     ${reset}/" \
        -e "s/^F /${red}  ✗     ${reset}/" \
        -e "s/^R /${yellow}  *     ${reset}/" \
        -e "s/^K /${gray}  -     ${reset}/" \
        -e "s/^T /${gray}  ○     ${reset}/" \
        -e "s/^? /${gray}  ?     ${reset}/"

    echo ""
    info "Run: prev-termux status <package> to filter"
}

# ─── Command: cache ──────────────────────────────────────────────────────────────
# Usage: prev-termux cache {info|clear [--all|<package>]}
#
# Manages the persistent version cache (see discover.sh).
#
cmd_cache() {
    local subcommand="${1:-}"

    case "$subcommand" in
        info)
            cache_stats
            ;;
        clear)
            local pkg="${2:-}"
            if [[ "$pkg" == "--all" ]]; then
                local cache_dir
                cache_dir="$(get_cache_dir)"
                rm -rf "${cache_dir:?}/versions" "${cache_dir:?}/repo"
                info "Caché completo eliminado (incluyendo repo bare)"
            elif [[ -n "$pkg" ]]; then
                clear_version_cache "$pkg"
                ok "Caché de '$pkg' eliminado"
            else
                clear_version_cache
                ok "Caché de versiones eliminado (repo bare conservado)"
            fi
            ;;
        *)
            err "Subcomando desconocido: $subcommand"
            echo "Uso: prev-termux cache {info|clear [--all|paquete]}"
            return 1
            ;;
    esac
}

# ─── Command: help ───────────────────────────────────────────────────────────────

cmd_help() {
    cat <<EOF
${BOLD}Usage:${NC} prev-termux <command> [options]

${BOLD}Commands:${NC}

  list <package> [--refresh]
      Discover and interactively select a historical version of a Termux
      package. Displays version, commit SHA, and date.
      --refresh   Force re-discovery, ignoring cache

  build <package> [--commit <sha>] [--refresh] [--heavy] [--subversioned]
      Interactive mode: pick a version via fzf, then either download an
      existing release or trigger the GHA build workflow.
      --commit <sha>  Direct mode: skip fzf, build the exact commit SHA.
      --refresh       Force re-discovery, ignoring cache
      --heavy         Optimize for heavy builds: ZRAM 16GB + free disk space
      --subversioned  Target the versioned release: tag {pkg}-{ver}-{sha7}-subversioned,
                      built with prefix ~/.local/opt/<pkg>-<ver>/.
                      Also accepted (no effect) by 'list'.

  fetch <package> [version] [--arch <arch>] [--subversioned] [--out <dir>]
      Download from the PrevTermux Store pool (GitHub Release
      prev-termux-pool-<arch> + manifest.json). Downloads the .deb, and the
      .pkg.tar.xz too for target packages (entry with pkg_tar).
      Without version: downloads it if only one is available, else lists them.
      --arch <arch>   Pool architecture (default: aarch64)
      --subversioned  Fetch the subversioned artifact (mode=subversioned)
      --out <dir>     Download directory (default: ./output)

  subinstall [<package>|<file.pkg.tar.xz>]
      Extract a .pkg.tar.xz to ~/.local/opt/<pkg>-<version>/
      Auto-detects the tar layout: subversioned
      (data/data/com.termux/files/home/.local/opt/...) vs standard
      (data/data/com.termux/files/usr/...).
      Creates versioned symlinks in ~/.local/bin/<bin>-<version>
      If no argument is given, shows all artifacts in output/ via fzf
      (or a numbered menu if fzf is not installed).
      If a package name is given, first picks the version (fzf or numbered
      menu; all available versions, newest first), then the mode
      (subversioned/normal, asked only when both exist), and downloads
      that release from GitHub and extracts it.
      If a .pkg.tar.xz file is given, extracts it directly.
      Never uses pacman -U — purely local extraction

  install <package> [<version>] [--arch <arch>]
      Install a NORMAL build of <package> with the detected package manager
      (pacman or apt): picks the version (fzf or numbered menu, only
      versions with a normal release), downloads its .pkg.tar.xz (pacman)
      or .deb (apt) to $TMPDIR and runs the manager WITHOUT auto-yes flags
      (the manager asks for confirmation).
      <version>    Skip the selector and use that exact version.
      --arch <arch>   Restrict the download pattern to that architecture

  switch [<package>]
      Switch the active subversioned version of <package> in $PREFIX/bin:
      (re)creates symlinks to $PREV_TERMUX_INSTALL_DIR/<pkg>-<ver>/bin/*,
      marking the current version with (actual). If <package> is omitted,
      pick it among the installed subversioned packages (fzf, or a
      numbered menu if fzf is not installed).

  status [<package>]
      Show recent workflow runs (status, package, elapsed).
      If package name is given, filter runs by it.

  cache info
      Show cache statistics (size, age, packages cached).

  cache clear [--all|<package>]
      Clear version cache (keeps bare repo unless --all).

  help
      Show this help message.

${BOLD}Examples:${NC}

  prev-termux list python
  prev-termux list python --refresh
  prev-termux build nodejs
  prev-termux build libfoo --commit a1b2c3d
  prev-termux build nodejs --refresh
  prev-termux build zig --commit a1b2c3d --heavy
  prev-termux build libfoo --commit a1b2c3d --subversioned
  prev-termux subinstall
  prev-termux subinstall ./output/bat-0.24.0-0-aarch64.pkg.tar.xz
  prev-termux subinstall bat
  prev-termux install bat
  prev-termux install bash 5.1.16 --arch aarch64
  prev-termux switch zig
  prev-termux switch
  prev-termux fetch ncurses
  prev-termux fetch ncurses 6.1.20180707 --arch aarch64
  prev-termux fetch bash 5.1.16 --subversioned --out /sdcard/Download
  prev-termux cache info
  prev-termux cache clear
  prev-termux cache clear python
  prev-termux cache clear --all
  prev-termux status
  prev-termux status zig

${BOLD}Environment:${NC}

  GITHUB_REPOSITORY   GitHub repository (owner/name) where releases
                      and the build workflow live.
                      Auto-detected when run inside a git clone.

  PREV_TERMUX_CACHE_DIR   Cache directory (default: ~/.cache/prev-termux)
  PREV_TERMUX_INSTALL_DIR Install directory for 'subinstall' and 'switch'
                          (default: ~/.local/opt)
  PREV_TERMUX_BIN_DIR     Symlink directory for 'subinstall' (default: ~/.local/bin)

${BOLD}Requirements:${NC}

  git, gh (GitHub CLI), jq
  fzf is optional (falls back to a numbered menu when absent).
  All available via: pkg install git fzf gh jq

${BOLD}Library dependencies:${NC}

  scripts/lib/discover.sh  (required — provides discover_versions,
                            extract_version, fzf_select, cache
                            management functions)
  scripts/lib/build.sh     (optional — loaded if present)
EOF
}

# ─── Main Dispatch ───────────────────────────────────────────────────────────────

main() {
    if [[ $# -eq 0 ]]; then
        cmd_help
        exit 0
    fi

    local command="$1"
    shift

    # Commands that bypass dependency checks
    case "$command" in
        help|--help|-h)
            cmd_help
            exit 0
            ;;
        cache)
            cmd_cache "$@"
            exit $?
            ;;
    esac

    # All other commands require dependencies
    check_deps

    case "$command" in
        list)
            [[ $# -lt 1 ]] && die "Usage: prev-termux list <package> [--refresh]"
            cmd_list "$@"
            ;;
        build)
            [[ $# -lt 1 ]] && die "Usage: prev-termux build <package> [--commit <sha>] [--refresh] [--heavy] [--subversioned]"
            cmd_build "$@"
            ;;
        fetch)
            [[ $# -lt 1 ]] && die "Usage: prev-termux fetch <package> [version] [--arch <arch>] [--subversioned] [--out <dir>]"
            cmd_fetch "$@"
            ;;
        subinstall)
            [[ $# -gt 1 ]] && die "Usage: prev-termux subinstall [<package>|<file.pkg.tar.xz>]"
            cmd_subinstall "$@"
            ;;
        install)
            [[ $# -lt 1 ]] && die "Usage: prev-termux install <package> [<version>] [--arch <arch>]"
            cmd_install "$@"
            ;;
        switch)
            cmd_switch "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        *)
            err "Unknown command: ${command}"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
