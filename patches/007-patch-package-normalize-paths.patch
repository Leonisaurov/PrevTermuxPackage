--- a/scripts/build/termux_step_patch_package.sh
+++ b/scripts/build/termux_step_patch_package.sh
@@ -2,6 +2,11 @@
 	[ "$TERMUX_PKG_METAPACKAGE" = "true" ] && return
 
 	cd "$TERMUX_PKG_SRCDIR"
+	echo "DEBUG: patch version: $(patch --version 2>&1 | head -1)"
+	echo "DEBUG: which patch: $(which patch 2>&1)"
+	echo "DEBUG: SRCDIR=$TERMUX_PKG_SRCDIR"
+	echo "DEBUG: CONTENIDO SRCDIR:"
+	ls -la "$TERMUX_PKG_SRCDIR" 2>&1 || true
 	# Suffix patch with ".patch32" or ".patch64" to only apply for
 	# these bitnesses
 	local PATCHES=$(find $TERMUX_PKG_BUILDER_DIR -mindepth 1 -maxdepth 1 \
@@ -19,19 +24,44 @@
 	shopt -s nullglob
 	for patch in $PATCHES $DEBUG_PATCHES $ON_DEVICE_PATCHES; do
 		echo "Applying patch: $(basename $patch)"
-		test -f "$patch" && sed \
-			-e "s%\@TERMUX_APP_PACKAGE\@%${TERMUX_APP_PACKAGE}%g" \
-			-e "s%\@TERMUX_BASE_DIR\@%${TERMUX_BASE_DIR}%g" \
-			-e "s%\@TERMUX_CACHE_DIR\@%${TERMUX_CACHE_DIR}%g" \
-			-e "s%\@TERMUX_HOME\@%${TERMUX_ANDROID_HOME}%g" \
-			-e "s%\@TERMUX_PREFIX\@%${TERMUX_PREFIX}%g" \
-			-e "s%\@TERMUX_PREFIX_CLASSICAL\@%${TERMUX_PREFIX_CLASSICAL}%g" \
-			-e "s%\@TERMUX_ENV__S_TERMUX\@%${TERMUX_ENV__S_TERMUX}%g" \
-			-e "s%\@TERMUX_ENV__S_TERMUX_APP\@%${TERMUX_ENV__S_TERMUX_APP}%g" \
-			-e "s%\@TERMUX_ENV__S_TERMUX_API_APP\@%${TERMUX_ENV__S_TERMUX_API_APP}%g" \
-			-e "s%\@TERMUX_ENV__S_TERMUX_ROOTFS\@%${TERMUX_ENV__S_TERMUX_ROOTFS}%g" \
-			-e "s%\@TERMUX_ENV__S_TERMUX_EXEC\@%${TERMUX_ENV__S_TERMUX_EXEC}%g" \
-			"$patch" | patch --silent -p1
+		echo "DEBUG: PATCH NORMALIZADO PARA $(basename $patch):"
+		sed -e "s%@TERMUX_PREFIX@%${TERMUX_PREFIX}%g" \
+		    -e "s%@TERMUX_HOME@%${TERMUX_ANDROID_HOME}%g" \
+		    -e "s%^--- \.\./[^/]*/%--- ./%g" \
+		    -e "s%^+++ \.\./[^/]*/%+++ ./%g" \
+		    "$patch" | head -20
+		echo "DEBUG VARS:"
+		echo "  TERMUX_APP_PACKAGE=${TERMUX_APP_PACKAGE-UNSET}"
+		echo "  TERMUX_BASE_DIR=${TERMUX_BASE_DIR-UNSET}"
+		echo "  TERMUX_CACHE_DIR=${TERMUX_CACHE_DIR-UNSET}"
+		echo "  TERMUX_ANDROID_HOME=${TERMUX_ANDROID_HOME-UNSET}"
+		echo "  TERMUX_PREFIX=${TERMUX_PREFIX-UNSET}"
+		echo "  TERMUX_PREFIX_CLASSICAL=${TERMUX_PREFIX_CLASSICAL-UNSET}"
+		echo "  TERMUX_ENV__S_TERMUX=${TERMUX_ENV__S_TERMUX-UNSET}"
+		echo "  TERMUX_ENV__S_TERMUX_APP=${TERMUX_ENV__S_TERMUX_APP-UNSET}"
+		echo "  TERMUX_ENV__S_TERMUX_API_APP=${TERMUX_ENV__S_TERMUX_API_APP-UNSET}"
+		echo "  TERMUX_ENV__S_TERMUX_ROOTFS=${TERMUX_ENV__S_TERMUX_ROOTFS-UNSET}"
+		echo "  TERMUX_ENV__S_TERMUX_EXEC=${TERMUX_ENV__S_TERMUX_EXEC-UNSET}"
+		# Capturar stderr del sed y patch por separado
+		sed -e "s%@TERMUX_APP_PACKAGE@%${TERMUX_APP_PACKAGE-}%g" \
+		    -e "s%@TERMUX_BASE_DIR@%${TERMUX_BASE_DIR-}%g" \
+		    -e "s%@TERMUX_CACHE_DIR@%${TERMUX_CACHE_DIR-}%g" \
+		    -e "s%@TERMUX_HOME@%${TERMUX_ANDROID_HOME-}%g" \
+		    -e "s%@TERMUX_PREFIX@%${TERMUX_PREFIX-}%g" \
+		    -e "s%@TERMUX_PREFIX_CLASSICAL@%${TERMUX_PREFIX_CLASSICAL-}%g" \
+		    -e "s%@TERMUX_ENV__S_TERMUX@%${TERMUX_ENV__S_TERMUX-}%g" \
+		    -e "s%@TERMUX_ENV__S_TERMUX_APP@%${TERMUX_ENV__S_TERMUX_APP-}%g" \
+		    -e "s%@TERMUX_ENV__S_TERMUX_API_APP@%${TERMUX_ENV__S_TERMUX_API_APP-}%g" \
+		    -e "s%@TERMUX_ENV__S_TERMUX_ROOTFS@%${TERMUX_ENV__S_TERMUX_ROOTFS-}%g" \
+		    -e "s%@TERMUX_ENV__S_TERMUX_EXEC@%${TERMUX_ENV__S_TERMUX_EXEC-}%g" \
+		    -e "s%^--- \.\./[^/]*/%--- ./%g" \
+		    -e "s%^+++ \.\./[^/]*/%+++ ./%g" \
+		    "$patch" > /tmp/normalized.patch 2>/tmp/sed-stderr.log
+		echo "SED EXIT: $?"
+		echo "SED STDERR:"; cat /tmp/sed-stderr.log 2>/dev/null
+		patch --batch -p1 < /tmp/normalized.patch 2>/tmp/patch-stderr.log
+		echo "PATCH EXIT: $?"
+		echo "PATCH STDERR:"; cat /tmp/patch-stderr.log 2>/dev/null
 	done
 	shopt -u nullglob
 }
