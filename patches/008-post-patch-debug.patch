 			termux_step_handle_host_build
 		fi
 
+		echo "MARKER: >>> setup_toolchain"
 		termux_step_setup_toolchain
+		echo "MARKER: <<< setup_toolchain OK (exit=$?)"
 
 		if [[ "$TERMUX_CONTINUE_BUILD" == "false" ]]; then
+			echo "MARKER: >>> get_dependencies_python"
 			termux_step_get_dependencies_python
+			echo "MARKER: <<< get_dependencies_python OK (exit=$?)"
+			echo "MARKER: >>> patch_package"
 			termux_step_patch_package
+			echo "MARKER: <<< patch_package OK (exit=$?)"
